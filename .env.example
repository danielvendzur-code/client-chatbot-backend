# Company (fill in when assigning the bot to a real client)
COMPANY_NAME="[Company Name]"
COMPANY_TAGLINE=""
COMPANY_WEBSITE="https://example.com"
COMPANY_EMAIL="hello@example.com"
COMPANY_PHONE=""
COMPANY_WHATSAPP=""
COMPANY_INDUSTRY=""

# Bot persona
BOT_NAME="Asistent"
BOT_INITIALS="AI"
BOT_WELCOME="Ahoj! Som virtuálny asistent. Ako ti môžem pomôcť?"
BOT_PLACEHOLDER="Napíš správu…"

# Theme (Tailwind emerald palette by default)
THEME_PRIMARY="#10b981"
THEME_PRIMARY_HOVER="#059669"
THEME_ACCENT="#34d399"
THEME_BG="#ffffff"
THEME_SURFACE="#f0fdf4"
THEME_TEXT="#0f172a"
THEME_TEXT_MUTED="#64748b"
THEME_BORDER="#d1fae5"
THEME_USER_BUBBLE="#10b981"
THEME_BOT_BUBBLE="#ecfdf5"
THEME_RADIUS="16px"
THEME_POSITION="right"

# Lead form copy
LEAD_TITLE="Zanechajte nám kontakt"
LEAD_SUBTITLE="Ozveme sa vám čo najskôr."
LEAD_BUTTON="Odoslať"
LEAD_BUTTON_OPEN="Zanechať kontakt"
LEAD_SUCCESS="Ďakujeme, ozveme sa vám."
LEAD_NAME_PLACEHOLDER="Vaše meno"
LEAD_EMAIL_PLACEHOLDER="E-mail"
LEAD_PHONE_PLACEHOLDER="Telefón (nepovinné)"
LEAD_MESSAGE_PLACEHOLDER="Správa (nepovinné)"

# Resend (email delivery for /api/lead)
RESEND_API_KEY=""
LEAD_TO=""
LEAD_FROM="onboarding@resend.dev"
LEAD_BCC=""

# LLM
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-6"
LLM_TEMPERATURE="0.4"
LLM_MAX_TOKENS="600"
ANTHROPIC_API_KEY=""

# CORS (comma-separated origins, * for any)
CORS_ORIGINS="*"
