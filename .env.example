# Company (fill in when assigning the bot to a real client)
COMPANY_NAME="[Company Name]"
COMPANY_TAGLINE=""
COMPANY_WEBSITE="https://example.com"
COMPANY_EMAIL="hello@example.com"
COMPANY_PHONE=""
COMPANY_INDUSTRY=""

# Bot persona
BOT_NAME="Asistent"
BOT_INITIALS="AI"
BOT_WELCOME="Ahoj! Som virtuálny asistent. Ako ti môžem pomôcť?"
BOT_PLACEHOLDER="Napíš správu…"

# Theme (optional overrides)
THEME_PRIMARY="#4f46e5"
THEME_PRIMARY_HOVER="#4338ca"
THEME_ACCENT="#22d3ee"
THEME_BG="#ffffff"
THEME_SURFACE="#f8fafc"
THEME_TEXT="#0f172a"
THEME_TEXT_MUTED="#64748b"
THEME_BORDER="#e2e8f0"
THEME_USER_BUBBLE="#4f46e5"
THEME_BOT_BUBBLE="#f1f5f9"
THEME_RADIUS="16px"
THEME_POSITION="right"

# LLM
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-6"
LLM_TEMPERATURE="0.4"
LLM_MAX_TOKENS="600"
ANTHROPIC_API_KEY=""

# CORS (comma-separated origins, * for any)
CORS_ORIGINS="*"
